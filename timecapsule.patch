+        if choice == "3":
+            picked = _prompt_for_simulation_date()
+            if picked is None:
+                continue
+            _set_simulation_date(picked)
+            return
+        if choice == "4":
+            picked = cis_timecapsule.surprise_date(current_user_id or "")
+            ansi_scroll(f"Your destination: {picked:%A, %B %d, %Y}.", 0.01)
+            _set_simulation_date(picked)
+            return
+        ansi_scroll("Enter 1, 2, 3, or 4.", 0.01)
+
