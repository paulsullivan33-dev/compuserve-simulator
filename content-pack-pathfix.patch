Subject: [PATCH] Fix hardcoded /home/hatch paths in tests: derive repo root
 from __file__

---
 test_compuserve.py | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/test_compuserve.py b/test_compuserve.py
index ead5562..9abfc74 100644
--- a/test_compuserve.py
+++ b/test_compuserve.py
@@ -2333,7 +2333,8 @@ if __name__ == "__main__":
 
 
 # --- Feature 1: ham radio forum (cis_hamnet) ---
-JSON_PATH = Path("/home/hatch/workspace/compuserve-simulator/computer_communities.json")
+REPO_ROOT = Path(__file__).resolve().parent
+JSON_PATH = REPO_ROOT / "computer_communities.json"
 
 REQUIRED_FIELDS = {"content_id", "section", "date", "author", "subject", "body", "parent"}
 
@@ -2992,7 +2993,7 @@ class SportsContentTests(unittest.TestCase):
 
 
 # --- Feature 5: era-aware world ---
-REPO = "/home/hatch/workspace/compuserve-simulator"
+REPO = str(REPO_ROOT)
 sys.path.insert(0, REPO)
 
 import cis_dynamic
