+        highlight1 = [l for l in dec1 if l.startswith("THIS WEEK:")]
+        highlight2 = [l for l in dec2 if l.startswith("THIS WEEK:")]
+        self.assertEqual(len(highlight1), 1)
+        self.assertNotEqual(highlight1, highlight2,
